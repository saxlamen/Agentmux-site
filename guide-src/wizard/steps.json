{
  "questions": [
    {
      "id": "machine",
      "options": [
        "mac",
        "linux",
        "vps",
        "windows",
        "none"
      ],
      "explain": {}
    },
    {
      "id": "agent",
      "options": [
        "claude",
        "codex",
        "gemini",
        "opencode",
        "shell"
      ]
    },
    {
      "id": "reach",
      "options": [
        "lan",
        "anywhere"
      ]
    }
  ],
  "steps": [
    {
      "id": "pick-machine",
      "when": {
        "machine": [
          "none"
        ]
      }
    },
    {
      "id": "enable-ssh-mac",
      "when": {
        "machine": [
          "mac"
        ]
      },
      "commands": [
        "sudo systemsetup -setremotelogin on"
      ],
      "verify": "ssh localhost whoami",
      "troubleshoot": "mac-remote-login"
    },
    {
      "id": "enable-ssh-linux",
      "when": {
        "machine": [
          "linux"
        ]
      },
      "commands": [
        "sudo apt-get update && sudo apt-get install -y openssh-server && sudo systemctl enable --now ssh    # Debian / Ubuntu",
        "sudo dnf install -y openssh-server && sudo systemctl enable --now sshd                              # Fedora / RHEL",
        "sudo pacman -S --noconfirm openssh && sudo systemctl enable --now sshd                              # Arch",
        "sudo apk add openssh && sudo rc-update add sshd default && sudo rc-service sshd start               # Alpine (OpenRC)"
      ],
      "verify": "systemctl status ssh || systemctl status sshd || rc-service sshd status",
      "troubleshoot": "cannot-connect"
    },
    {
      "id": "vps-ssh-ready",
      "when": {
        "machine": [
          "vps"
        ]
      },
      "verify": "whoami",
      "troubleshoot": "cannot-connect"
    },
    {
      "id": "enable-ssh-windows",
      "when": {
        "machine": [
          "windows"
        ]
      },
      "commands": [
        "Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0",
        "Start-Service sshd",
        "Set-Service -Name sshd -StartupType Automatic"
      ],
      "verify": "Get-Service sshd | Select-Object Status,StartType",
      "troubleshoot": "cannot-connect"
    },
    {
      "id": "keep-awake-windows",
      "when": {
        "machine": [
          "windows"
        ]
      },
      "commands": [
        "powercfg /change standby-timeout-ac 0",
        "powercfg /change hibernate-timeout-ac 0"
      ],
      "verify": "powercfg /query SCHEME_CURRENT SUB_SLEEP STANDBYIDLE"
    },
    {
      "id": "install-agent",
      "when": {
        "agent": [
          "claude",
          "codex",
          "gemini",
          "opencode"
        ],
        "machine": [
          "mac",
          "linux",
          "vps",
          "none"
        ]
      },
      "verify": "which claude || which codex || which gemini || which opencode",
      "troubleshoot": "agent-command-not-found"
    },
    {
      "id": "install-agent-windows",
      "when": {
        "agent": [
          "claude",
          "codex",
          "gemini",
          "opencode"
        ],
        "machine": [
          "windows"
        ]
      },
      "verify": "where.exe claude",
      "troubleshoot": "agent-command-not-found"
    },
    {
      "id": "psmux-handled",
      "when": {
        "machine": [
          "windows"
        ]
      },
      "commands": [
        "winget install -e --id marlocarlo.psmux --accept-package-agreements --accept-source-agreements"
      ],
      "verify": "where.exe psmux",
      "troubleshoot": "tmux-not-found"
    },
    {
      "id": "tmux-handled",
      "when": {
        "machine": [
          "mac",
          "linux",
          "vps",
          "none"
        ]
      }
    },
    {
      "id": "tailscale-host",
      "when": {
        "reach": [
          "anywhere"
        ]
      },
      "verify": "tailscale status",
      "troubleshoot": "tailscale-connected-but-ssh-fails"
    },
    {
      "id": "tailscale-ios",
      "when": {
        "reach": [
          "anywhere"
        ]
      },
      "troubleshoot": "tailscale-connected-but-ssh-fails"
    },
    {
      "id": "find-lan-address",
      "when": {
        "reach": [
          "lan"
        ],
        "machine": [
          "mac"
        ]
      },
      "commands": [
        "ipconfig getifaddr en0"
      ],
      "troubleshoot": "cannot-connect"
    },
    {
      "id": "find-lan-address-linux",
      "when": {
        "reach": [
          "lan"
        ],
        "machine": [
          "linux"
        ]
      },
      "commands": [
        "hostname -I"
      ],
      "troubleshoot": "cannot-connect"
    },
    {
      "id": "find-lan-address-windows",
      "when": {
        "reach": [
          "lan"
        ],
        "machine": [
          "windows"
        ]
      },
      "commands": [
        "ipconfig | findstr /i IPv4"
      ],
      "troubleshoot": "cannot-connect"
    },
    {
      "id": "add-server"
    }
  ]
}
